#!/bin/sh
set -eu

case "${XDG_CURRENT_DESKTOP-}" in
    *XFCE*) ;;
    *)
        echo "Refusing desktop toggle outside XFCE." >&2
        exit 1
        ;;
esac

showing=$(xprop -root _NET_SHOWING_DESKTOP 2>/dev/null |
    awk -F'= ' 'NF > 1 { print $2; exit }')

case "$showing" in
    1) exec wmctrl -k off ;;
    *) exec wmctrl -k on ;;
esac
